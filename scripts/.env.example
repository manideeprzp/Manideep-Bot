# DevRev (required for scripts)
DEVREV_API_KEY=your-devrev-personal-access-token

# Optional: Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# For the bot: set SLACK_BOT_TOKEN and SLACK_APP_TOKEN in the shell when running the bot

# AI for suggestions: use one of these
# Option 1 – Claude (Anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# Option 2 – Gemini (no Anthropic key needed; get key at https://aistudio.google.com/apikey)
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key

# Optional: Pod for unassigned monitoring
# DEVREV_POD_PART_ID=

# Monitor: PSE pod – use part names (no IDs needed). Pipe-separated if setting via env.
# DEVREV_MONITOR_PART_NAMES=distribution channel and reseller|issuance|wallet as service
# Or set applies_to_part_names in config/env.dev.yaml (preferred).
# Optional: part IDs instead – DEVREV_MONITOR_PART_IDS=id1,id2,id3

# Solved tickets: refresh interval for fetch_my_solved (default 24 = once per day)
# DEVREV_SOLVED_FETCH_INTERVAL_HOURS=24

# Solved states (optional)
# DEVREV_SOLVED_STATES=closed,done,resolved

# Note: Your DevRev workflow has these STAGES:
# "To Do", "Under Investigation", "Awaiting Info", "Escalated to Dev", "Review", "Testing", "Triage"
# The bot monitors all tickets assigned to you in open states, regardless of stage.
# Stage names are shown in Slack alerts for context.
